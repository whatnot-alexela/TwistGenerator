# Copy to .env on the server and fill in. Never commit the real file.
# The bot token and the API key are set directly on the server — they must not
# appear in a chat, an issue, or a commit.

BOT_TOKEN=
ANTHROPIC_API_KEY=
OWNER_TELEGRAM_ID=
DATABASE_URL=postgresql+asyncpg://twist:CHANGEME@postgres:5432/twist
METHODOLOGY_URL=https://kiloslov.ru

# --- Claude ---------------------------------------------------------------- #
# The bot must run outside Russia: it is not a supported region for the
# Anthropic API. See docs/SPEC.md §5.2 and §11.1.
ANTHROPIC_MODEL=claude-opus-5
GENERATION_EFFORT=high
ANALYSIS_EFFORT=low
MAX_TOKENS=8000

# full = the methodology unabridged (default); condensed = §10 and the two
# paradox appendices replaced by their condensed variants. docs/SPEC.md §4.2.
PROMPT_PROFILE=full

# Off until sustained traffic exceeds roughly one generation per five minutes,
# or the cache write is paid on nearly every request and never read back.
ANTHROPIC_PROMPT_CACHE=off

# --- Free allowances, per user per day ------------------------------------- #
FREE_FORMULA_GENS_PER_DAY=3
FREE_EXPECTATION_GENS_PER_DAY=1
FREE_ANALYSES_PER_DAY=5

# --- Budget caps, USD ------------------------------------------------------ #
# Evaluated against recorded spend, not an estimate. The monthly cap is the
# hard wall; the emergency stop covers free and paid alike.
DAILY_FREE_BUDGET_USD=4
MONTHLY_FREE_BUDGET_USD=100
EMERGENCY_STOP_USD=250

# --- Telegram Stars packs -------------------------------------------------- #
# Break-even is ~19 stars per unit and the loader refuses anything under 20.
# Re-derive these from measured spend before opening payments. docs/SPEC.md §7.4.
PACK_SMALL_UNITS=10
PACK_SMALL_STARS=260
PACK_MEDIUM_UNITS=30
PACK_MEDIUM_STARS=700
PACK_LARGE_UNITS=100
PACK_LARGE_STARS=2100
